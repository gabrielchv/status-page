# Copy to .env.local for local development.

# --- Database: use EITHER TCP (local dev / Neon) OR socket (Cloud Run -> Cloud SQL) ---

# TCP connection string (local Docker / Neon / Cloud SQL public IP).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/statuspage

# Socket mode (Cloud Run built-in Cloud SQL connector). Set these instead of
# DATABASE_URL when deploying with `--add-cloudsql-instances`:
# DATABASE_SOCKET=/cloudsql/PROJECT:REGION:INSTANCE
# DATABASE_USER=postgres
# DATABASE_PASSWORD=...
# DATABASE_NAME=statuspage

# Used to derive password/session hashing. Any long random string.
AUTH_SECRET=change-me-to-a-long-random-string

# Shared secret for the Cloud Scheduler -> /api/internal/run-checks call.
CHECK_RUNNER_SECRET=change-me-to-another-long-random-string

# Public URL of the app (used for links).
APP_URL=http://localhost:3000
